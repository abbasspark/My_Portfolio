{
  "name": "abbas-bandar-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "homepage": "https://abbasbandar.netlify.app",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"./**/*.{ts,tsx,css,json,html,md}\"",
    "check-format": "prettier -c \"./**/*.{ts,tsx,css,json,html,md}\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.37.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
